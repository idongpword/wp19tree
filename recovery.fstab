# Android fstab file for Oukitel WP19 Pro (MediaTek MT6789)
# system, vendor, product, system_ext are managed dynamically by vold/first_stage_mount

/metadata                 ext4     /dev/block/by-name/metadata                      flags=display="Metadata";backup=1;wrappedkey
/data                     f2fs     /dev/block/by-name/userdata                      flags=display="Userdata";backup=1;fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,metadata_encryption=aes-256-xts;keydirectory=/metadata/vold/metadata_encryption

# External Storage & USB OTG
/external_sd              vfat     /dev/block/mmcblk0p1       /dev/block/mmcblk0    flags=display="Micro SDcard";storage;wipeingui;removable
/usb_otg                  vfat     /dev/block/sdda1           /dev/block/sdda       flags=display="USB-OTG";storage;wipeingui;removable

# Critical Boot & Metadata Partitions
/boot                     emmc     /dev/block/by-name/boot                          flags=display="Boot";backup=1;flashimg=1;slotselect
/vendor_boot              emmc     /dev/block/by-name/vendor_boot                   flags=display="Vendor Boot";backup=1;flashimg=1
/dtbo                     emmc     /dev/block/by-name/dtbo                          flags=display="DTBO";backup=1;flashimg=1
/vbmeta                   emmc     /dev/block/by-name/vbmeta                        flags=display="VBMeta";backup=1;flashimg=1
/vbmeta_system            emmc     /dev/block/by-name/vbmeta_system                 flags=display="VBMeta System";backup=1;flashimg=1;slotselect
/vbmeta_vendor            emmc     /dev/block/by-name/vbmeta_vendor                 flags=display="VBMeta Vendor";backup=1;flashimg=1;slotselect

# Persistent & NVRAM Data
/nvram                    emmc     /dev/block/by-name/nvram                         flags=display="NVRAM";backup=1
/nvdata                   ext4     /dev/block/by-name/nvdata                        flags=display="NVData";backup=1;subpartitionof=/nvram
/protect_f                ext4     /dev/block/by-name/protect1                      flags=display="Protect F";backup=1
/protect_s                ext4     /dev/block/by-name/protect2                      flags=display="Protect S";backup=1
/persistent               emmc     /dev/block/by-name/frp                           flags=display="FRP";backup=1
/misc                     emmc     /dev/block/by-name/misc                          flags=display="Misc"
